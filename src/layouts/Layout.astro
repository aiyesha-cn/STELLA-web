---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'STELLA Vault — Paluwagan savings, unchained.',
  description = 'The digital paluwagan for every Filipino. Save together, build trust, and grow your money on Stellar — no bank account required.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/og-image.png" />

    <!-- Fonts: swap for your licensed/self-hosted files in public/fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="overflow-x-hidden">
    <slot />
  </body>
</html>
