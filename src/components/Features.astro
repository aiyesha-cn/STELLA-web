---
const features = [
  {
    title: 'Community vaults',
    desc: 'Start or join a savings circle with people you trust. Everyone contributes on schedule, and the payout rotates — just like a paluwagan, tracked automatically.',
  },
  {
    title: 'Progressive verification',
    desc: 'Start with just a phone number. Unlock higher limits as you build reputation — through on-time deposits and a clean track record, not paperwork.',
  },
  {
    title: 'USDC, priced in pesos',
    desc: 'Your savings move in USDC under the hood but every screen speaks pesos. Cash out to GCash, bank transfer, or padala partners nationwide.',
  },
  {
    title: 'Built on Stellar',
    desc: 'Fast, low-fee settlement with full transaction history on-chain. Your vault balance is verifiable — not just a number on someone else\'s spreadsheet.',
  },
];
---

<section id="features" class="py-28">
  <div class="container-page">
    <div class="max-w-2xl">
      <span class="text-sm font-semibold uppercase tracking-wider text-ember-500">Features</span>
      <h2 class="mt-3 font-display text-4xl font-bold text-white sm:text-5xl">
        Everything a paluwagan needs. Nothing it doesn't.
      </h2>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        features.map((f) => (
          <div class="group rounded-xl2 border border-white/10 bg-night-900/60 p-8 transition-colors hover:border-ember-500/40">
            <h3 class="font-display text-xl font-semibold text-white">{f.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist-300">{f.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
