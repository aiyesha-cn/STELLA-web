---
const links = [
  { label: 'Features', href: '#features' },
  { label: 'How it works', href: '#how-it-works' },
  { label: 'FAQ', href: '#faq' },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="container-page">
    <nav
      class="mt-4 flex items-center justify-between rounded-full border border-white/10
        bg-night-900/70 px-5 py-3 backdrop-blur-lg"
    >
      <a href="/" class="flex items-center gap-2 font-display text-lg font-semibold text-white">
        <span class="grid h-8 w-8 place-items-center rounded-lg bg-ember-500 text-night-950">✦</span>
        STELLA
      </a>

      <ul class="hidden items-center gap-8 md:flex">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-mist-300 transition-colors hover:text-white">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a href="#download" class="btn-primary !px-5 !py-2.5 text-sm">
        Download
      </a>
    </nav>
  </div>
</header>
